using eg.windows
using eg.shapes
using eg.spatials
using eg.spirv

window1 {
    WindowCreateInfo : {debug: false, enable_opengl: false}
    Position2 : {0, 0}
    Rectangle : {1024, 1024}
}

displays {
    eg.displays.Update
}

const shader_file_vertex: entity = eg.fs.path1("./data/vertex.spv")
const shader_file_fragment: entity = eg.fs.path1("./data/fragment.spv")

$shader_file_vertex {
    eg.fs.Reader
}

$shader_file_fragment {
    eg.fs.Reader
}

struct Vertex123(
    pos:{f32,count:2, unit: flecs.units.Length.Meters}, 
    uv:{f32,count:2, unit: flecs.units.Length.Meters}, 
    color:{u8, count:4, unit: flecs.units.Color.Rgb}
)
{
    pos {
        eg.gpus.Location : {0}
    }
    uv {
        eg.gpus.Location : {1}
    }
    color {
        eg.gpus.Location : {2}
        eg.spatials.Normalized
    }
}


gpu0 {
	eg.gpus.DeviceCreateInfo : {
		debug: true,
	}

    shader_vertex {
        eg.spirv.Reflect : {stage: Vertex}
        eg.gpus.ShaderCreateInfo : {stage: Vertex}
        (flecs.core.DependsOn, $shader_file_vertex)
    }
    
    shader_fragment {
        eg.spirv.Reflect : {stage: Fragment}
        eg.gpus.ShaderCreateInfo : {stage: Fragment}
        (flecs.core.DependsOn, $shader_file_fragment)
    }

    depth_texture {
        eg.gpus.Texture
        eg.gpus.TextureCreateInfo : {
            sample_count: 1,
            usage: DepthStencil,
            format: D16Unorm
        }
        Rectangle : {w: 1024, h: 1024}
    }

    vertex_buffer {
        eg.gpus.BufferCreateInfo : {
            size: 120,
            usage: Vertex
        }
    }

    white_texture {
        eg.gpus.Texture
        eg.gpus.TextureCreateInfo : {
            sample_count: 1,
            usage: Sampled,
            format: Rgba8Unorm
        }
        Rectangle : {w: 1, h: 1}
    }

    nearest_sampler {
        eg.gpus.SamplerCreateInfo : {
            min_filter: Nearest,
            mag_filter: Nearest,
            address_mode_u: ClampToEdge,
            address_mode_v: ClampToEdge,
            address_mode_w: ClampToEdge
        }
    }

    pip {
        eg.gpus.GraphicsPipelineCreateInfo : {
            sample_count: 1
        }
        (flecs.core.DependsOn, Vertex123)
        (flecs.core.DependsOn, shader_vertex)
        (flecs.core.DependsOn, shader_fragment)
    }
}



