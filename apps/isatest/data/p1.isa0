CREATE_STACK CURRENT_SWEEP CONST flecs.meta.f32
PUSH         CURRENT_SWEEP CONST 1
PUSH         CURRENT_SWEEP CONST 4
PUSH         CURRENT_SWEEP CONST 7


CREATE_STACK POSITIONS1 CONST eg.spatials.Position3
PUSH         POSITIONS1 CONST {1,2,3}
PUSH         POSITIONS1 CONST {1,2,3}
PUSH         POSITIONS1 CONST {1,2,3}


CREATE_STACK POSITIONS2 CONST eg.spatials.Position3
PUSH         POSITIONS2 CONST {1,2,3}
PUSH         POSITIONS2 CONST {1,2,3}
PUSH         POSITIONS2 POP   POSITIONS1

PRINT        isa.Stdout CONST hello
PRINT        isa.Stdout POP   POSITIONS2

PUSH         isa.Stdout CONST hello-via-push
PUSH         isa.Stdout POP   POSITIONS2

