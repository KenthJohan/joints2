module xui

using flecs.script
using eg.cameras
using eg.shapes
using eg.ui.flows
using eg.shapedraw

template Flow1 {
    prop camera: entity = cameras.cam_hud.mouse_unproject
    prop thickness: f32 = 4
    prop scale: f32 = 1

    Flow : {direction: Right, wrap: Down}
    Element child_a {
        Rectangle : {w: 50 * scale, h: 50 * scale}
        Solid : {color: 0xFF44FF00}
        ResizableRect : {min_w: 10 * scale, min_h: 10 * scale, thickness: thickness * scale, font_size: 10}
    }
    Element child_b {
        Rectangle : {w: 50 * scale, h: 50 * scale}
        Solid : {color: 0xFF6058FF}
        ResizableRect : {min_w: 10 * scale, min_h: 10 * scale, thickness: thickness * scale, font_size: 10}
    }
    Element child_c {
        Rectangle : {w: 56 * scale, h: 53 * scale}
        Solid : {color: 0xFF337733}
        ResizableRect : {min_w: 10 * scale, min_h: 10 * scale, thickness: thickness * scale, font_size: 10}
    }
    Element child_d {
        Rectangle : {w: 106 * scale, h: 103 * scale}
        Solid : {color: 0xFF2F2700}
        ResizableRect : {min_w: 10 * scale, min_h: 10 * scale, thickness: thickness * scale, font_size: 10}
    }
}
