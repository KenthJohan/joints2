module xui

using flecs.script
using eg.shapes
using eg.ui
using eg.shapedraw


// Interaction base: tracks hover and whether `button` (flecs: 0=left, 1=middle, 2=right) is held.
// mouse_cam selects the camera whose mouse unprojection drives hit testing.
template Button {
    prop mouse_cam: entity = cameras.cam_hud.mouse_unproject
    prop button: i32 = 0
    (eg.ui.Mouse, mouse_cam)
    eg.ui.local.mouse.Position
    eg.ui.script.events.Target
    mut hover = false
    mut held = false
    async {
        while true {
            await on.enter(this)
            hover = true
            await on.leave(this)
            hover = false
        }
    }
    async {
        while true {
            const e = await on.press(this)
            if e.button == button {
                held = true
            }
        }
    }
    async {
        while true {
            const e = await on.release(this)
            if e.button == button {
                held = false
            }
        }
    }
}

template Button2 : Button {
    Element
    Solid : {color: 0xFF44FF00}
    mut checked = false
    if hover {
        Solid : {color: 0xFF4B413C}
    } else {
        Solid : {color: 0xFF292320}
    }
    if checked {
        mark {
            Element
            Rectangle : {w: 14, h: 14}
            Solid : {color: 0xFF7AA862}
        }
    }
    async {
        while true {
            await on.click(this)
            checked = !checked
        }
    }
}
