module xui

using flecs.script
using eg.shapes
using eg.ui
using eg.ui.bounds
using eg.ui.freeforms
using eg.shapedraw
using eg.base

// Makes a rectangle resizable by dragging four thin strips along its border.
// Dragging a strip writes an EdgeRequest holding the absolute local position the edge should move to.
// The rectangle (Resizable) decides how much of the request is honored.

// State shared between the rectangle and its strips: which edge is dragged and the pending request.
template ResizeState {
    mut active: i32 = 0
    mut req_edges: i32 = 0
    mut req_left: f32 = 0
    mut req_right: f32 = 0
    mut req_bottom: f32 = 0
    mut req_top: f32 = 0
}

// Shared by the four strips: highlights the strip while hovered or dragged.
template ResizeEdge : parent ResizeState {
    prop mouse_cam: entity = cameras.cam_hud.mouse_unproject
    // EG_UI_EDGE_* mask: 1 left, 2 right, 4 bottom, 8 top
    prop edge: i32 = 2
    Element
    (eg.ui.Mouse, mouse_cam)
    eg.ui.local.mouse.Position
    eg.ui.script.events.Target
    mut hover = false
    mut grab = false
    if edge == 1 {
        Anchor : {parent: Left, pivot: Middle}
    } else if edge == 2 {
        Anchor : {parent: Right, pivot: Middle}
    } else if edge == 4 {
        Anchor : {parent: Bottom, pivot: Middle}
    } else {
        Anchor : {parent: Top, pivot: Middle}
    }
    if grab {
        Solid : {color: 0xCCFF4040}
    } else if hover {
        Solid : {color: 0x88FFFFFF}
    } else {
        Solid : {color: 0x00000000}
    }
    async {
        while true {
            await on.enter(this)
            hover = true
            await on.leave(this)
            hover = false
        }
    }
    async {
        while true {
            await on.press(this)
            grab = true
            active = edge
        }
    }
    async {
        while true {
            await on.release(this)
            grab = false
            active = 0
            req_edges = 0
        }
    }
}

template ResizableRect : ResizeState {
    prop min_w: f32 = 20
    prop min_h: f32 = 20
    prop thickness: f32 = 6
    prop font_size: f32 = 28
    prop border_thickness: f32 = 2
    // Camera whose mouse unprojection drives hit testing; this is what differs between HUD and world.
    prop mouse_cam: entity = cameras.cam_hud.mouse_unproject

    Resizable : {min_w: min_w, min_h: min_h}
    EdgeRequest : {edges: req_edges, left: req_left, right: req_right, bottom: req_bottom, top: req_top}
    Element
    (eg.ui.Mouse, mouse_cam)
    eg.ui.local.mouse.Position
    eg.ui.script.events.Target
    Font : {font_size: font_size}
    Text : {value: "1"}
    Border : {thickness: border_thickness, color: 0xFF888888}
    // Drags on a strip propagate here in this rectangle's local space: the edge goes where the pointer is.
    // 
    async {
        while true {
            const e = await on.drag(this)
            if active == 1 {
                req_left = e.local_x
            } else if active == 2 {
                req_right = e.local_x
            } else if active == 4 {
                req_bottom = e.local_y
            } else if active == 8 {
                req_top = e.local_y
            }
            req_edges = active
        }
    }
    left { ResizeEdge : {edge: 1, mouse_cam: mouse_cam}
        Rectangle : {w: thickness, h: $this[Rectangle].h}
    }
    right { ResizeEdge : {edge: 2, mouse_cam: mouse_cam}
        Rectangle : {w: thickness, h: $this[Rectangle].h}
    }
    top { ResizeEdge : {edge: 8, mouse_cam: mouse_cam}
        Rectangle : {w: $this[Rectangle].w, h: thickness}
    }
    bottom { ResizeEdge : {edge: 4, mouse_cam: mouse_cam}
        Rectangle : {w: $this[Rectangle].w, h: thickness}
    }
}
