}

hud_text_hint {
    Position2 : {5, 5}
    eg.base.Text : {value: "Drag bodies with mouse"}
    eg.base.Font : {font_size: 18}
    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
}
