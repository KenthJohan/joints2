module physics
using eg.physics
using eg.shapes
using eg.spatials
using eg.ui
using eg.shapedraw
using eg.base

// zero mass, zero velocity, may be manually moved
const BODY_STATIC: i32 = 0

// zero mass, velocity set by user, moved by solver
const BODY_KINEMATIC: i32 = 1

// positive mass, velocity determined by forces, moved by solver
const BODY_DYNAMIC: i32 = 2

debug_draw {
    app.draw.box2d.ContextCreate : {}
    (flecs.core.DependsOn, eg.windows.window1.drawctx_1)
}

b2world {
    dragbody {}
}


template Button1 {
    (OverlapChecking, cameras.cam0.mouse_unproject) : {tag: tags.mouse_hover}
    Button : {key: eg.buttons.MOUSE_LEFT}
    if $this[Button].held {
        Border : {thickness: 0.1, color: 0xFFFF0000}
        d1 {
            (JointDef, b2world.dragbody) : {linear_hertz: 7.5, linear_damping: 1.0}
        }
        Text : {value: ""}
        Font : {font_size: 1}
        Color : {color: 0xFF00FFFF}
    } else if $this[Button].hovered {
        //if eg.buttons.State[eg.buttons.State].mouse[0] {}
        Border : {thickness: 0.1, color: 0xFF000000}
        Text : {value: "{this.name}"}
        Font : {font_size: 1}
        Color : {color: 0xFF00FFFF}
    } else {
        Border : {thickness: 0, color: 0xFFFF00FF}
        Text : {value: ""}
        Font : {font_size: 1}
        Color : {color: 0xFF00FFFF}
    }
}




b2world {
    // (OverlapChecking, cameras.cam0.mouse_unproject) : {tag: tags.mouse_hover}
    eg.physics.WorldDef : {gravity_x: 0, gravity_y: -10}
    (flecs.core.DependsOn, debug_draw)
    eg.shapedraw.List

    ground {
        WorldTransform3
        BodyDef : {type : $BODY_STATIC}
        ShapesDef : {density:0, friction:0}
        Position2 : {0, -5}
        Rectangle : {w:50, h:10}
        Solid : {color: 0xFF44FF00}
    }
    
    box1 {
        WorldTransform3
        BodyDef : {type : $BODY_DYNAMIC}
        ShapesDef : {density:1, friction:0.3}
        Position2 : {0, 4}
        Rectangle : {w:1, h:1}
        Solid : {color: 0xFF44FF00}
        Button1


    }


    // Follows the mouse position:
    dragbody {
        WorldTransform3
        BodyDef : {type : $BODY_KINEMATIC}
        Position2 : {0, -10}
        (eg.physics.TargetTransform, cameras.cam0.mouse_unproject)
        // eg.b2.DragBody : {target: keybindings.mouse_hit_focus}
    }



    box2 {
        WorldTransform3
        BodyDef : {type : $BODY_DYNAMIC}
        ShapesDef : {density:1}
        Position2 : {0.1, 9.0}
        Rectangle : {w:1, h:1}
        Solid : {color: 0xFF44FF00}
        Button1
    }


}





