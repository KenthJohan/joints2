module physics
using flecs.script
using eg.physics
using eg.shapes
using eg.spatials
using eg.ui
using eg.ui.bounds
using eg.ui.flows
using eg.ui.freeforms
using eg.shapedraw
using eg.base

// zero mass, zero velocity, may be manually moved
const BODY_STATIC: i32 = 0

// zero mass, velocity set by user, moved by solver
const BODY_KINEMATIC: i32 = 1

// positive mass, velocity determined by forces, moved by solver
const BODY_DYNAMIC: i32 = 2


// Forward declaration of the mouse drag body used for dragging other bodies with the mouse.
b2world {
    mouse_dragbody {}
}



// Border thickness and Buttons.Border margin are in screen pixels, independent of camera distance.
template Interactable {
    (eg.ui.Mouse, cameras.cam0.mouse_unproject)
    eg.ui.local.mouse.Position
    eg.ui.script.events.Target
}


template DragButton1 {
    Interactable
    mut held = false
    mut hover = false
    Font : {font_size: 30, color: 0xFFFFFFFF}
    if held {
        Border : {thickness: 2, color: 0xFFFF0000}
        d1 {
            // Attaches this body to the mouse drag body using a joint.
            // This allows the body to follow the mouse while maintaining physics interactions.
            (JointDef, b2world.mouse_dragbody) : {linear_hertz: 7.5, linear_damping: 1.0}
        }
        Text : {value: ""}
    } else if hover {
        Border : {thickness: 2, color: 0xFFFFFFFF}
        Text : {value: "{$this.name()}"}
    } else {
        Border : {thickness: 2, color: 0xFF000000}
        Text : {value: ""}
    }
    async {
        while true {
            await on.enter(this)
            hover = true
            await on.leave(this)
            hover = false
        }
    }
    // Right mouse button (flecs button 2)
    async {
        while true {
            const e = await on.press(this)
            if e.button == 2 {
                held = true
            }
        }
    }
    async {
        while true {
            const e = await on.release(this)
            if e.button == 2 {
                held = false
            }
        }
    }
}

template Element {
    WorldTransform3
    Transform3
    Rotation2 : {0}
    Scale2 : {x: 1, y: 1}
    Position2 : {x: 0, y: 0}
}

template ResizeBase {
    prop min_w: f32 = 0.1
    prop min_h: f32 = 0.1
    prop thickness: f32 = 0.06

    mut active: i32 = 0
    mut req_edges: i32 = 0
    mut req_left: f32 = 0
    mut req_right: f32 = 0
    mut req_bottom: f32 = 0
    mut req_top: f32 = 0

    Resizable : {min_w: min_w, min_h: min_h}
    EdgeRequest : {edges: req_edges, left: req_left, right: req_right, bottom: req_bottom, top: req_top}
}

// Shared by the four strips: highlights the strip while hovered or dragged.
template ResizeEdge : parent ResizeBase {
    Element
    Interactable
    mut hover = false
    mut grab = false
    if grab {
        Solid : {color: 0xCCFF4040}
    } else if hover {
        Solid : {color: 0x88FFFFFF}
    } else {
        Solid : {color: 0x00000000}
    }
    async {
        while true {
            await on.enter(this)
            hover = true
            await on.leave(this)
            hover = false
        }
    }
}

template ResizeRight : ResizeEdge {
    Anchor : {parent: Right, pivot: Middle}
    async {
        while true {
            await on.press(this)
            grab = true
            active = 2
        }
    }
    async {
        while true {
            await on.release(this)
            grab = false
            active = 0
            req_edges = 0
        }
    }
}

template ResizeLeft : ResizeEdge {
    Anchor : {parent: Left, pivot: Middle}
    async {
        while true {
            await on.press(this)
            grab = true
            active = 1
        }
    }
    async {
        while true {
            await on.release(this)
            grab = false
            active = 0
            req_edges = 0
        }
    }
}

template ResizeTop : ResizeEdge {
    Anchor : {parent: Top, pivot: Middle}
    async {
        while true {
            await on.press(this)
            grab = true
            active = 8
        }
    }
    async {
        while true {
            await on.release(this)
            grab = false
            active = 0
            req_edges = 0
        }
    }
}

template ResizeBottom : ResizeEdge {
    Anchor : {parent: Bottom, pivot: Middle}
    async {
        while true {
            await on.press(this)
            grab = true
            active = 4
        }
    }
    async {
        while true {
            await on.release(this)
            grab = false
            active = 0
            req_edges = 0
        }
    }
}

template ResizableRect : ResizeBase {
    Element
    Interactable
    Font : {font_size: 10}
    Text : {value: "1"}
    Border : {thickness: 1, color: 0xFF888888}
    // Drags on a strip propagate here in this rectangle's local space: the edge goes where the pointer is.
    async {
        while true {
            const e = await on.drag(this)
            if active == 1 {
                req_left = e.local_x
            } else if active == 2 {
                req_right = e.local_x
            } else if active == 4 {
                req_bottom = e.local_y
            } else if active == 8 {
                req_top = e.local_y
            }
            req_edges = active
        }
    }
    left { ResizeLeft
        Rectangle : {w: thickness, h: $this[Rectangle].h}
    }
    right { ResizeRight
        Rectangle : {w: thickness, h: $this[Rectangle].h}
    }
    top { ResizeTop
        Rectangle : {w: $this[Rectangle].w, h: thickness}
    }
    bottom { ResizeBottom
        Rectangle : {w: $this[Rectangle].w, h: thickness}
    }
}

template Flow1 {
    Flow : {direction: Right, wrap: Down}
    Element child_a {
        Rectangle : {w: 0.14, h: 0.14}
        Solid : {color: 0xFF44FF00}
        ResizableRect
    }
    Element child_b {
        Rectangle : {w: 0.36, h: 0.33}
        Solid : {color: 0xFF6058FF}
        ResizableRect
    }
    Element child_c {
        Rectangle : {w: 0.56, h: 0.53}
        Solid : {color: 0xFF337733}
        ResizableRect
    }
    Element child_d {
        Rectangle : {w: 1.06, h: 1.03}
        Solid : {color: 0xFF2F2700}
        ResizableRect
    }
}


b2world {
    // Defines the physics world and its properties
    eg.physics.WorldDef : {gravity_x: 0, gravity_y: -10}

    // Renders shapes from eg.shapedraw.List
    (flecs.core.DependsOn, eg.windows.window1.drawctx_1)

    // Collects all shapes for rendering
    eg.shapedraw.List

    ground {
        WorldTransform3 : trs(0, -5, 0, 1, 1)
        BodyDef : {type : $BODY_STATIC}
        ShapesDef : {density:0, friction:0}
        Rectangle : {w:50, h:10}
        Solid : {color: 0xFF333333}
    }
    
    box1 {
        WorldTransform3 : trs(0, 4, 0, 1, 1)
        BodyDef : {type : $BODY_DYNAMIC}
        ShapesDef : {density:1, friction:0.3}
        Rectangle : {w:1, h:1}
        Solid : {color: 0xFF44FF00}
        Border : {thickness: 0.1, color: 0xFF000000}
    }



    
    box2 {
        WorldTransform3 : trs(0, 9, 0, 1, 1)
        BodyDef : {type : $BODY_DYNAMIC}
        ShapesDef : {density:1}
        Rectangle : {w:2, h:2}
        Solid : {color: 0xFF441144}
        DragButton1
        Flow1
    }
    


    // This body does not collide with other bodies.
    // It is controlled directly by the mouse position.
    // It is typically used to drag other bodies around by applying a joint between this body and the target body.
    mouse_dragbody {
        WorldTransform3 : trs(0, 0, 0, 1, 1)
        BodyDef : {type : $BODY_KINEMATIC}
        (eg.physics.TargetTransform, cameras.cam0.mouse_unproject)
    }


}
