@color #FF99FF
keybindings {}
module keybindings
using eg.spatials
using eg.buttons

const ROTATE_SPEED = 0.005
const TRANSLATE_SPEED = 1.0

camera_rotate_dx {
    eg.buttons.Binding : {
        button0:SCANCODE_UP, 
        button1:SCANCODE_DOWN, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Rotate3, 
        byte_offset:0, 
        factor: $ROTATE_SPEED
    }
}

camera_rotate_dy {
    eg.buttons.Binding : {
        button0:SCANCODE_LEFT, 
        button1:SCANCODE_RIGHT, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : { 
        entity:cameras.cam0, 
        component:Rotate3, 
        byte_offset:4, 
        factor: -$ROTATE_SPEED
    }
}

camera_rotate_dz {
    eg.buttons.Binding : {
        button0:SCANCODE_E, 
        button1:SCANCODE_Q, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Rotate3, 
        byte_offset:8, 
        factor: $ROTATE_SPEED
    }
}

camera_move_dx {
    eg.buttons.Binding : {
        button0:SCANCODE_D, 
        button1:SCANCODE_A, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:0, 
        factor: $TRANSLATE_SPEED
    }
}

camera_move_dy {
    eg.buttons.Binding : {
        button0:SCANCODE_LCTRL, 
        button1:SCANCODE_SPACE, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:4, 
        factor: -$TRANSLATE_SPEED
    }
}

camera_move_dz {
    eg.buttons.Binding : {
        button0:SCANCODE_W, 
        button1:SCANCODE_S, 
        mask:BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:8, 
        factor: -$TRANSLATE_SPEED
    }
}
