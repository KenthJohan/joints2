module keybindings
using eg.spatials
using eg.buttons


camera_rotate_dz {
    eg.buttons.Binding : {
        button0:MOUSE_X1, 
        button1:MOUSE_X2, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Rotate3, 
        byte_offset:8, 
        factor: 0.01,
        w0: 0,
        w1: 1,
    }
}

camera_move_dx {
    eg.buttons.Binding : {
        button0:SCANCODE_D, 
        button1:SCANCODE_A, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:0, 
        factor: 10.01,
        w0: 0,
        w1: 1,
    }
}

camera_move_dy {
    eg.buttons.Binding : {
        button0:SCANCODE_W, 
        button1:SCANCODE_S, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:4, 
        factor: 10.01,
        w0: 0,
        w1: 1,
    }
}

camera_move_dz {
    eg.buttons.Binding : {
        button0:SCANCODE_KP_MINUS, 
        button1:SCANCODE_KP_PLUS, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:8, 
        factor: 10.01,
        w0: 0,
        w1: 1,
    }
}


rotate_text1 {
    eg.buttons.Binding : {
        button0:eg.buttons.SCANCODE_Y, 
        button1:eg.buttons.SCANCODE_U, 
        mask:eg.buttons.BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:huds.root3d, 
        component:Rotate3, 
        byte_offset:8, 
        factor: 0.005,
        w0: 0,
        w1: 1,
    }
}



rotate_text2 {
    eg.buttons.Binding : {
        button0:eg.buttons.SCANCODE_I, 
        button1:eg.buttons.SCANCODE_O, 
        mask:eg.buttons.BUTTON_HELD 
    }
    eg.buttons.Incrementer : {
        entity:huds.root3d.hud_text_hint, 
        component:Rotate3, 
        byte_offset:8, 
        factor: 0.005,
        w0: 0,
        w1: 1,
    }
}
