@color #FF99FF
keybindings {}
module keybindings
using eg.spatials
using eg.buttons



camera_rotate_dz {
    eg.buttons.Binding : {
        button0:MOUSE_X1, 
        button1:MOUSE_X2, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Rotate3, 
        byte_offset:8, 
        factor: 0.01
    }
}

camera_move_dx {
    eg.buttons.Binding : {
        button0:SCANCODE_D, 
        button1:SCANCODE_A, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:0, 
        factor: 10.01
    }
}

camera_move_dy {
    eg.buttons.Binding : {
        button0:SCANCODE_W, 
        button1:SCANCODE_S, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:4, 
        factor: 10.01
    }
}

camera_move_dz {
    eg.buttons.Binding : {
        button0:SCANCODE_KP_MINUS, 
        button1:SCANCODE_KP_PLUS, 
        mask:BUTTON_HELD, 
    }
    eg.buttons.Incrementer : {
        entity:cameras.cam0, 
        component:Velocity3, 
        byte_offset:8, 
        factor: 10.01
    }
}

quit {
    eg.buttons.Binding : {
        button0:SCANCODE_ESCAPE, 
        mask:BUTTON_PRESSED, 
    }
    eg.buttons.ActionToggleEntity : {
        entity:eg.windows.window1, 
        relation:0, 
        toggle:eg.windows.CloseRequest
    }
}

// If the left mouse button is pressed,
// remove the mouse_focus tag for the entities which have the mouse_focus tag
unselect {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_focus, 
        tag: tags.mouse_focus,
        add:false
    }
}

// If the left mouse button is pressed,
// add the mouse_focus tag for the entities which have the mouse_hover tag
select {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover, 
        tag: tags.mouse_focus,
        add:true
    }
}

// If the left mouse button is pressed,
// add the mouse_drag tag for the entities which have the mouse_hover tag
drag_begin {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover, 
        tag: tags.mouse_drag,
        add:true
    }
}

// If the left mouse button is released,
// remove the mouse_drag tag for the entities which have the mouse_drag tag
drag_end {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_RELEASED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_drag, 
        tag: tags.mouse_drag,
        add:false
    }
}
