// Forward declare the camera so that it can be used in the window draw context
cameras.cam0 {}
cameras.cam_hud {}

module eg.windows
using eg.shapes
using eg.spatials

window1 {
    WindowCreateInfo : {debug: false, enable_opengl: true}
    Position2 : {0, 0}
    Rectangle : {1024, 1024}
    OpenGLContextCreate : {0}

    drawctx_1 {
        app.draw.ContextCreate : {0}
        (flecs.core.DependsOn, cameras.cam0)
    }

    drawctx_hud {
        app.draw.ContextCreate : {0}
        (flecs.core.DependsOn, cameras.cam_hud)
    }

    mouse {
        Position2
        eg.windows.Mouse
    }

    mouse_normalized {
        (Position2, Normalized) : {0,0}
        eg.windows.Mouse
    }
}



debug_draw_print_hover {
    app.draw.NameAtPositionRule : {
        term: tags.mouse_hover, 
        draw_e : eg.windows.window1.drawctx_1,
        color: 0xFF99FF
    }
}

debug_draw_print_drag {
    app.draw.NameAtPositionRule : {
        term: tags.mouse_drag, 
        draw_e : eg.windows.window1.drawctx_1, 
        color: 0x66FFFF
    }
}


debug_draw_print_focus {
    app.draw.NameAtPositionRule : {
        term: tags.mouse_focus, 
        draw_e : eg.windows.window1.drawctx_1, 
        color: 0xFF9911
    }
}
