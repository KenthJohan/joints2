module eg.windows

using eg.shapes
using eg.spatials
using eg.windows


window1 {
    WindowCreateInfo : {debug: false, enable_opengl: true}
    Position2 : {0, 0}
    Rectangle : {1024, 1024}
    OpenGLContextCreate : {0}


    drawctx_hud {
        app.draw.ContextCreate : {0}
        (flecs.core.DependsOn, cameras.cam_hud)
    }
    
    drawctx_1 {
        app.draw.ContextCreate : {0}
        (flecs.core.DependsOn, cameras.cam0)
    }

    mouse {
        Position2
        eg.windows.Mouse
    }

    mouse_normalized {
        (Position2, Normalized) : {0,0}
        eg.windows.Mouse
    }
}



