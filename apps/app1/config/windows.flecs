module eg.windows

using eg.shapes
using eg.spatials
using eg.windows


window1 {
    WindowCreateInfo : {debug: false, enable_opengl: true}
    
    app.draw.GpuPicking

    Position2 : {0, 0}
    Rectangle : {1024, 1024}
    OpenGLContextCreate : {0}
    app.draw.Clear : {r: 0, g: 0, b: 1, a: 1}


    drawctx_hud {
        app.draw.Pass : {order: 20}
        (app.draw.Camera, cameras.cam_hud)
    }
    
    drawctx_1 {
        app.draw.Pass : {order: 10}
        (app.draw.Camera, cameras.cam0)
    }

    mouse {
        Position2
        eg.windows.Mouse
    }

    mouse_normalized {
        (Position2, Normalized) : {0,0}
        eg.windows.Mouse
    }
}
