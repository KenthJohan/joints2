using eg.spatials
using eg.buttons

keybindings {

quit {
    eg.buttons.Binding : {
        button0:SCANCODE_ESCAPE, 
        mask:BUTTON_PRESSED, 
    }
    eg.buttons.ActionToggleEntity : {
        entity:eg.windows.window1, 
        relation:0, 
        toggle:eg.windows.CloseRequest
    }
}

// If the left mouse button is pressed,
// remove the mouse_focus tag for the entities which have the mouse_focus tag
unselect {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_focus, 
        tag: tags.mouse_focus,
        add:false
    }
}

unselect_hud {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT,
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_focus_hud,
        tag: tags.mouse_focus_hud,
        add:false
    }
}

// If the left mouse button is pressed,
// add the mouse_focus tag for the entities which have the mouse_hover tag
select {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover, 
        tag: tags.mouse_focus,
        add:true
    }
}

select_hud {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT,
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover_hud,
        tag: tags.mouse_focus_hud,
        add:true
    }
}

// If the left mouse button is pressed,
// add the mouse_drag tag for the entities which have the mouse_hover tag
drag_begin {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover, 
        tag: tags.mouse_drag,
        add:true
    }
}

drag_begin_hud {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT,
        mask:BUTTON_PRESSED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_hover_hud,
        tag: tags.mouse_drag_hud,
        add:true
    }
}

// If the left mouse button is released,
// remove the mouse_drag tag for the entities which have the mouse_drag tag
drag_end {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT, 
        mask:BUTTON_RELEASED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_drag, 
        tag: tags.mouse_drag,
        add:false
    }
}

drag_end_hud {
    eg.buttons.Binding : {
        button0:MOUSE_LEFT,
        mask:BUTTON_RELEASED
    }
    eg.buttons.EngageRule : {
        term: tags.mouse_drag_hud,
        tag: tags.mouse_drag_hud,
        add:false
    }
}

}
