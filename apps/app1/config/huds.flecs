module huds
using eg.spatials
using eg.shapes
using eg.ui
using eg.base

prefab element3d {
    WorldTransform4
    Transform4
	RotateOrder1
	Orientation
	Scale3 : {x: 1, y: 1, z: 1}
	Position3 : {x: 0, y: 0, z: 0}
    Rotate3 : {0,0,0}
}

prefab element2d {
    WorldTransform3
    Transform3
    Rotation2 : {0}
    Scale2 : {x: 1, y: 1}
    Position2 : {x: 0, y: 0}
}

with  (flecs.core.DependsOn, eg.windows.window1.drawctx_hud) {
root3d : element3d {
	Position3 : {x: -1024.0*0.5, y: 1024.0*0.5, z: 0}
	Scale3 : {x: 1, y: 1, z: 1}
    Rectangle : {w: 50, h: 50}
}

root3d : element3d {

    hud_text_title : element3d {
        Position3 : {100, 100, 0}
        Text : {value: "JOINTS2 HUD"}
        Font : {font_size: 28}
        Color : {color: 0xFF00FFFF}
    }

    hud_text_hint : element3d {
        Position3 : {50, 50, 0}
        Text : {value: "Drag bodies with mouse"}
        Font : {font_size: 18}
    }


    box1 : element3d {
        Position3 : {100, 100, 0}
        Rectangle : {w: 5, h: 5}
        Font : {font_size: 18}
        Color : {color: 0xFFFF0000}
    }
}

root2d : element2d {
    (eg.ui.MouseHitTesting, cameras.cam_hud.mouse_unproject) : {tag: tags.mouse_hover_hud}
}

root2d : element2d {
    // Lays its children out left-to-right, moving down when a row reaches the parent edge
    flow_demo : element2d {
        Position2 : {300, 300}
        Rectangle : {w: 200, h: 100}
        Flow : {direction: Right, wrap: Down}
        //Color : {color: 0xFFFFFFFF}

        child_a : element2d {
            Rectangle : {w: 40, h: 40}
            Color : {color: 0xFF44FF00}
        }
        child_b : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF6058FF}
        }
        child_c : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF007733}
        }
        child_d : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF2F2700}
        }
    }

    // Cells are placed by Cell {row, col}; rows/columns size to their largest child
    table_demo : element2d {
        Position2 : {300, 500}
        Table : {row_gap: 5, col_gap: 5}

        cell_a : element2d {
            Cell : {row: 0, col: 0}
            Rectangle : {w: 40, h: 40}
            Color : {color: 0xFF44FF00}
        }
        cell_b : element2d {
            Cell : {row: 0, col: 1}
            Rectangle : {w: 80, h: 20}
            Color : {color: 0xFF6058FF}
        }
        cell_c : element2d {
            Cell : {row: 1, col: 0}
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF007733}
        }
        cell_d : element2d {
            Cell : {row: 1, col: 1}
            Rectangle : {w: 30, h: 30}
            Color : {color: 0xFF2F2700}
        }
    }
}

}
