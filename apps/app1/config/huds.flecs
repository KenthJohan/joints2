module huds
using eg.spatials
using eg.shapes
using eg.ui
using eg.ui.buttons
using eg.base
using eg.shapedraw

template Element {
    WorldTransform3
    Transform3
    Rotation2 : {0}
    Scale2 : {x: 1, y: 1}
    Position2 : {x: 0, y: 0}
    (eg.physics.OverlapChecking, cameras.cam_hud.mouse_unproject) : {0}
    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
}

template Button1 {
    Element
    Button : {key: eg.buttons.MOUSE_LEFT}
    Solid : {color: 0xFF44FF00}
    if $this[Button].held {
        Border : {thickness: 6, color: 0xFFFF0000}
    } else if $this[Button].hovered {
        //if eg.buttons.State[eg.buttons.State].mouse[0] {}
        Border : {thickness: 10, color: 0xFF000000}
    } else {
        Border : {thickness: 0, color: 0xFFFF00FF}
    }
}


template ResizableRect {
    Resizable : {key: eg.buttons.MOUSE_LEFT, min_w: 20, min_h: 20}
    eg.intersects.RectangleBorder : {margin: 6}
    Font : {font_size: 28}
    if $this[Resizable].dragging {
        Text : {value: "dragging"}
        Border : {thickness: 4, color: 0xFFFF0000}
    } else if $this[Resizable].edge {
        Text : {value: "edge"}
        Border : {thickness: 8, color: 0xFF000000}
    } else {
        Text : {value: "1"}
        Border : {thickness: 2, color: 0xFF888888}
    }
}

root2d {
    Container

    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
    eg.shapedraw.List

    panel {
        Element
        Position2 : {300, 200}
        Rectangle : {w: 150, h: 100}
        Container
        ResizableRect
        child1 {
            Element
            Anchor : {parent: TopRight, pivot: TopRight, x: -10, y: -10}
            ResizableRect
            Rectangle : {w: 40, h: 40}
            Solid : {color: 0xFF44FF00}
        }
    }

    Element flow_demo {
        Position2 : {100, 100}
        Rectangle : {w: 200, h: 100}
        Border : {thickness: 2, color: 0xFFFFFFFF}
        Flow : {direction: Right, wrap: Down}
        ResizableRect

        Element child_a {
            Rectangle : {w: 40, h: 40}
            Solid : {color: 0xFF44FF00}
            ResizableRect
        }
        Element child_b {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF6058FF}
            ResizableRect
        }
        Element child_c {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF337733}
            ResizableRect
        }
        Element child_d {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF2F2700}
            ResizableRect
        }
    }
}

