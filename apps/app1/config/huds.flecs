module huds
using flecs.script
using eg.spatials
using eg.shapes
using eg.ui
using eg.ui.buttons
using eg.ui.flows
using eg.ui.bounds
using eg.ui.freeforms
using eg.base
using eg.shapedraw
using eg.buttons
using xui






root2d {
    Layout : {dummy: 0}

    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
    eg.shapedraw.List

    Button2 button2 {
        Position2 : {200, 100}
        Rectangle : {w: 60, h: 60}
    }

    panel {
        Element
        Position2 : {300, 200}
        Rectangle : {w: 150, h: 100}
        Layout : {dummy: 0}
        ResizableRect
        child1 {
            Element
            Anchor : {parent: TopRight, pivot: TopRight, x: -10, y: -10}
            Rectangle : {w: 40, h: 40}
            ResizableRect
            Solid : {color: 0xFF44FF00}
        }
    }

    Checkbox checkbox1 {
        Position2 : {x: 500, y: 100}
    }

    Element flow_demo {
        Position2 : {100, 100}
        Rectangle : {w: 200, h: 100}
        Border : {thickness: 2, color: 0xFFFFFFFF}
        Flow : {direction: Right, wrap: Down}
        ResizableRect

        Element child_a {
            Rectangle : {w: 40, h: 40}
            Solid : {color: 0xFF44FF00}
            ResizableRect
        }
        Element child_b {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF6058FF}
            ResizableRect
        }
        Element child_c {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF337733}
            ResizableRect
        }
        Element child_d {
            Rectangle : {w: 60, h: 30}
            Solid : {color: 0xFF2F2700}
            ResizableRect
        }
    }
}
