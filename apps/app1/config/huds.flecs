module huds
using eg.spatials
using eg.shapes
using eg.ui
using eg.base

prefab element2d {
    WorldTransform3
    Transform3
    Rotation2 : {0}
    Scale2 : {x: 1, y: 1}
    Position2 : {x: 0, y: 0}
    (eg.physics.OverlapChecking, cameras.cam_hud.mouse_unproject) : {tag: tags.mouse_hover_hud}
    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
}




root2d : element2d {

    (flecs.core.DependsOn, eg.windows.window1.drawctx_hud)
    eg.shapedraw.List


    hud_text_title : element2d {
        Position2 : {100, 100}
        Text : {value: "JOINTS2 HUD"}
        Font : {font_size: 28}
        Color : {color: 0xFF00FFFF}
    }

    hud_text_hint : element2d {
        Position2 : {50, 50}
        Text : {value: "Drag bodies with mouse"}
        Font : {font_size: 18}
    }

    box1 : element2d {
        Position2 : {100, 100}
        Rectangle : {w: 5, h: 5}
        Font : {font_size: 18}
        Color : {color: 0xFFFF0000}
    }

    // Lays its children out left-to-right, moving down when a row reaches the parent edge
    flow_demo : element2d {
        Position2 : {300, 300}
        Rectangle : {w: 200, h: 100}
        Flow : {direction: Right, wrap: Down}
        //Color : {color: 0xFFFFFFFF}

        child_a : element2d {
            Rectangle : {w: 40, h: 40}
            Color : {color: 0xFF44FF00}
        }
        child_b : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF6058FF}
        }
        child_c : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF337733}
        }
        child_d : element2d {
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF2F2700}
        }
    }

    // Cells are placed by Cell {row, col}; rows/columns size to their largest child
    table_demo : element2d {
        Position2 : {300, 400}
        Table : {row_gap: 5, col_gap: 5}

        cell_a : element2d {
            Cell : {row: 0, col: 0}
            Rectangle : {w: 40, h: 40}
            Color : {color: 0xFF44FF00}
        }
        cell_b : element2d {
            Cell : {row: 0, col: 1}
            Rectangle : {w: 80, h: 20}
            Color : {color: 0xFF6058FF}
        }
        cell_c : element2d {
            Cell : {row: 1, col: 0}
            Rectangle : {w: 60, h: 30}
            Color : {color: 0xFF007733}
        }
        cell_d : element2d {
            Cell : {row: 1, col: 1}
            Color : {color: 0xFF2F2700}
            Rectangle : {w: 60, h: 30}
            Text : {value: "Cell D"}
            Font : {font_size: 18, color: 0xFFFFFFFF}
        }
    }
}

